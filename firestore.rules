rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // A ride: created by its rider (an anonymous account per phone), who can read it back.
    match /rides/{rideId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'route', 'startedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.route is string
        && request.resource.data.route.size() <= 5
        && request.resource.data.startedAt == request.time;
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;

      // One GPS fix: only new ones, only the rider's own, only the expected fields.
      match /points/{pointId} {
        allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['time', 'gps_time', 'lat', 'lon', 'accuracy_m',
               'speed_mps', 'heading_deg', 'altitude_m', 'altitude_accuracy_m', 'uid', 'savedAt'])
          && request.resource.data.lat is number
          && request.resource.data.lon is number
          && request.resource.data.accuracy_m is number
          && request.resource.data.savedAt == request.time;
        allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      }
    }

    // Everything else, including the old hello test, is closed.
  }
}